#!/bin/bash
#
# FourierPartial.app launcher.
#
# Double-clicked from Finder. Starts the local backend, waits until it answers
# /api/health, opens the browser, and stays alive so the app keeps a Dock icon.
# Quitting the app stops the server.
#
# Design rule for everything below: NEVER fail silently. A double-clicked app
# that does nothing is indistinguishable from a broken Mac, so every exit path
# that is not "the user quit" ends in a visible dialog.
#
# There is no `set -e` here on purpose: an unexpected non-zero from any probe
# must reach the error dialog, not abort the script before it can show one.
set -u

# ---------------------------------------------------------------------------
# 1. Work out where we are
# ---------------------------------------------------------------------------
# Resolve symlinks first: someone may symlink the app into /Applications, and
# $0 would then point at the link rather than at the bundle.
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
    link_target="$(readlink "$SELF")"
    case "$link_target" in
        /*) SELF="$link_target" ;;
        *) SELF="$(dirname "$SELF")/$link_target" ;;
    esac
done

MACOS_DIR="$(cd "$(dirname "$SELF")" && pwd -P)"
# Contents/MacOS -> Contents -> FourierPartial.app -> project root.
# The bundle lives inside the project, so three levels up is the checkout, and
# the app keeps working wherever that folder is moved or renamed.
PROJECT_ROOT="$(cd "$MACOS_DIR/../../.." && pwd -P)"

APP_NAME="FourierPartial"
PYTHON_BIN="$PROJECT_ROOT/.venv/bin/python"
SESSION_DIR="$PROJECT_ROOT/sessions"
# The log and pid live OUTSIDE the session directory on purpose. The server
# treats sessions/ as its own scratch space and clears it on shutdown, so a log
# kept in there would be deleted at exactly the moment it became interesting.
LOG_DIR="$PROJECT_ROOT/logs"
LOG_FILE="$LOG_DIR/server.log"
PID_FILE="$LOG_DIR/server.pid"
COMMON_LIB="$PROJECT_ROOT/scripts/launch_common.sh"

# ---------------------------------------------------------------------------
# 2. Native error dialog
# ---------------------------------------------------------------------------
# The message is passed to osascript as an argv item rather than interpolated
# into the AppleScript source. Log excerpts contain quotes and backslashes, and
# splicing those into a script is both a syntax hazard and a code-injection one.
show_error() {
    /usr/bin/osascript - "$APP_NAME" "$1" >/dev/null 2>&1 <<'APPLESCRIPT'
on run argv
    set appName to item 1 of argv
    set bodyText to item 2 of argv
    display dialog bodyText with title appName buttons {"OK"} default button "OK" with icon stop
end run
APPLESCRIPT
    # osascript can fail (no window server, user logged out). Say it on stderr
    # too so `Console.app` and `open -W` still show something.
    printf '%s: %s\n' "$APP_NAME" "$1" >&2
}

# ---------------------------------------------------------------------------
# 3. Preflight
# ---------------------------------------------------------------------------
if [ ! -r "$COMMON_LIB" ]; then
    show_error "Cannot find the fourier_partial project files.

Expected to find:
    $COMMON_LIB

FourierPartial.app must stay inside the fourier_partial project folder. Move the whole folder rather than the app on its own, then try again."
    exit 1
fi
# shellcheck source=../../../scripts/launch_common.sh
. "$COMMON_LIB"

if [ ! -x "$PYTHON_BIN" ]; then
    show_error "The Python environment for fourier_partial has not been created yet.

Expected to find:
    $PYTHON_BIN

Open Terminal and run these three commands:

    cd $PROJECT_ROOT
    python3 -m venv .venv
    .venv/bin/pip install -r requirements.txt

Then double-click FourierPartial again."
    exit 1
fi

if [ ! -f "$PROJECT_ROOT/backend/main.py" ]; then
    show_error "The fourier_partial backend is missing.

Expected to find:
    $PROJECT_ROOT/backend/main.py

FourierPartial.app must stay inside the fourier_partial project folder."
    exit 1
fi

# ---------------------------------------------------------------------------
# 4. Start the server
# ---------------------------------------------------------------------------
if ! mkdir -p "$LOG_DIR" "$SESSION_DIR" 2>/dev/null; then
    show_error "Could not create the working folders:

    $LOG_DIR
    $SESSION_DIR

Check that the fourier_partial folder is writable and not on a read-only volume."
    exit 1
fi

# A previous run may have been Force Quit (SIGKILL cannot be trapped), leaving
# its server alive and holding the port.
fp_reap_orphan "$PID_FILE"

SERVER_PID=""
cleanup() {
    trap - EXIT INT TERM HUP
    fp_stop_server "$SERVER_PID"
    rm -f "$PID_FILE"
}
trap cleanup EXIT INT TERM HUP

: >"$LOG_FILE"
cd "$PROJECT_ROOT" || {
    show_error "Could not enter the project folder:

    $PROJECT_ROOT"
    exit 1
}

# stdout and stderr both go to the log: uvicorn writes its banner to one and
# tracebacks to the other, and the readiness probe needs to read both.
"$PYTHON_BIN" -m backend.main >>"$LOG_FILE" 2>&1 &
SERVER_PID=$!
printf '%s\n' "$SERVER_PID" >"$PID_FILE"

# ---------------------------------------------------------------------------
# 5. Wait for readiness, then open the browser
# ---------------------------------------------------------------------------
URL="$(fp_wait_ready "$LOG_FILE" "$SERVER_PID")"
ready_status=$?

if [ "$ready_status" -ne 0 ]; then
    if [ "$ready_status" -eq 2 ]; then
        reason="The fourier_partial server stopped right after starting."
    elif [ -z "$(fp_detect_url "$LOG_FILE")" ]; then
        reason="The fourier_partial server never reported an address within ${FP_READY_TIMEOUT} seconds."
    else
        reason="The fourier_partial server started at $(fp_detect_url "$LOG_FILE") but did not answer within ${FP_READY_TIMEOUT} seconds."
    fi
    show_error "$reason

Last lines of the log:

$(fp_log_tail "$LOG_FILE" 12)

Full log:
    $LOG_FILE"
    exit 1
fi

/usr/bin/open "$URL" || show_error "The server is running at $URL but the browser could not be opened. Paste that address into a browser to continue."

# ---------------------------------------------------------------------------
# 6. Stay alive
# ---------------------------------------------------------------------------
# Holding the foreground keeps the Dock icon present. When the user quits the
# app the trap above stops the server; if the server exits on its own, `wait`
# returns and the app closes with it.
wait "$SERVER_PID"
exit $?
