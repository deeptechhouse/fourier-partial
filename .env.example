# fourier_partial — environment template.
# Copy to `.env` and adjust. `.env` is gitignored and must never be committed.

# --- Server -------------------------------------------------------------------
# Port is a *preferred* port. If occupied, the app auto-selects a free one
# (see backend/config.py :: resolve_port).
FP_HOST=127.0.0.1
FP_PORT=8420

# --- Upload limits (security: see TDD §13) ------------------------------------
# 10 minutes of 24-bit stereo WAV is ~158 MB, so the byte ceiling has to clear
# that for the duration ceiling to be reachable with uncompressed input.
FP_MAX_UPLOAD_BYTES=268435456    # 256 MB hard ceiling on any uploaded file
FP_MAX_DURATION_SECONDS=600.0    # Reject audio longer than this (10 minutes)

# --- Session storage ----------------------------------------------------------
FP_SESSION_DIR=./sessions        # Ephemeral analysis artifacts
FP_SESSION_TTL_SECONDS=3600      # Sessions purged after this long

# --- CORS ---------------------------------------------------------------------
# Explicit origins only. Never use "*" in production.
FP_ALLOWED_ORIGINS=http://127.0.0.1:8420

# --- Logging ------------------------------------------------------------------
FP_LOG_LEVEL=INFO
